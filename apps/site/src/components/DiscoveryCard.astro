---
interface Props {
  title: string;
  description: string;
  href: string;
  eyebrow: string;
}

const { title, description, href, eyebrow } = Astro.props;
---

<article
  class="group rounded-xl border border-border-default bg-surface-elevated p-5 shadow-sm transition duration-normal hover:-translate-y-1 hover:shadow-md"
>
  <p class="text-sm font-semibold uppercase tracking-[0.12em] text-action-primary">{eyebrow}</p>
  <h3 class="mt-3 text-xl font-bold text-content-primary">{title}</h3>
  <p class="mt-2 text-content-muted">{description}</p>
  <a
    class="mt-5 inline-flex min-h-11 items-center font-semibold text-action-primary underline-offset-4 group-hover:underline"
    href={href}
  >
    Pelajari lebih lanjut
  </a>
</article>
