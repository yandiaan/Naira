---
import FeatureGrid from '../components/FeatureGrid.astro';
import TrustSignal from '../components/TrustSignal.astro';
import WelcomeMenu from '../components/WelcomeMenu.svelte';
import SiteLayout from '../layouts/SiteLayout.astro';

const features = [
  {
    eyebrow: 'Rencana',
    title: 'Rencana pendakian yang lebih jelas.',
    description: 'Susun itinerary dan kebutuhan perjalanan tanpa kehilangan konteks.',
    href: '/app',
  },
  {
    eyebrow: 'Gear',
    title: 'Siapkan gear dengan tenang.',
    description: 'Kelola checklist perlengkapan berdasarkan perjalanan yang sedang disiapkan.',
    href: '/app',
  },
  {
    eyebrow: 'Logistik',
    title: 'Jaga detail tetap siap.',
    description: 'Satukan catatan, waktu, dan kebutuhan grup dalam satu workspace.',
    href: '/app',
  },
];

const trustSignals = [
  { label: 'Satu ruang kerja', description: 'Semua persiapan tersusun dalam konteks trip.' },
  {
    label: 'Siap untuk kondisi lapangan',
    description: 'Status offline dan sync dirancang sejak awal.',
  },
  {
    label: 'Dibuat untuk ekosistem pendakian',
    description: 'Bahasa dan pola disusun untuk perjalanan outdoor.',
  },
];
---

<SiteLayout title="Naira · Rencana outdoor dengan lebih siap">
  <header class="mx-auto flex w-[min(100%-2rem,72rem)] items-center justify-between gap-4 py-4">
    <a class="text-lg font-extrabold text-content-primary" href="/" aria-label="Naira beranda"
      >Naira</a
    >
    <WelcomeMenu client:load />
  </header>

  <main id="main-content" class="mx-auto w-[min(100%-2rem,72rem)]">
    <section
      class="grid min-h-[min(78vh,52rem)] content-center gap-6 py-12 md:grid-cols-[1.2fr_0.8fr] md:gap-12 md:py-20"
      aria-labelledby="hero-title"
    >
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-action-primary">
          Outdoor planning, made clear
        </p>
        <h1
          id="hero-title"
          class="mt-4 text-5xl font-extrabold leading-[0.98] tracking-tight text-content-primary sm:text-6xl md:text-8xl"
        >
          Rencanakan perjalanan yang ingin kamu jalani.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-content-muted md:text-xl">
          Naira membantu pendaki menyiapkan itinerary, gear, logistik, dan detail perjalanan dengan
          lebih siap.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-md bg-action-primary px-5 font-semibold text-content-on-action transition-opacity duration-fast hover:opacity-90"
            href="/app">Mulai merencanakan</a
          >
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-md px-4 font-semibold text-action-primary underline-offset-4 hover:underline"
            href="#discovery">Jelajahi cara kerja</a
          >
        </div>
      </div>

      <div
        class="relative min-h-72 overflow-hidden rounded-[2rem] bg-action-primary p-6 text-content-on-action shadow-lg md:min-h-96"
      >
        <div class="absolute -right-16 -top-16 size-56 rounded-full bg-action-accent/50"></div>
        <div class="absolute -bottom-20 -left-10 size-64 rounded-full bg-action-accent/70"></div>
        <div class="relative flex h-full flex-col justify-between">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-content-on-action/80">
            Naira workspace
          </p>
          <div>
            <p class="text-3xl font-bold">Satu trip.</p>
            <p class="text-3xl font-bold text-content-on-action">Lebih siap.</p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="discovery"
      class="border-t border-border-default py-12 md:py-20"
      aria-labelledby="discovery-title"
    >
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-action-primary">
          Foundation for every trip
        </p>
        <h2 id="discovery-title" class="mt-3 text-3xl font-bold text-content-primary md:text-5xl">
          Semua persiapan punya tempatnya.
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-content-muted">
          Mulai dari rencana besar sampai detail kecil yang sering terlupa.
        </p>
      </div>
      <div class="mt-8"><FeatureGrid features={features} /></div>
    </section>

    <section
      class="grid gap-4 border-t border-border-default py-12 md:grid-cols-3 md:py-16"
      aria-label="Naira trust signals"
    >
      {trustSignals.map((signal) => <TrustSignal {...signal} />)}
    </section>
  </main>

  <footer
    class="mx-auto w-[min(100%-2rem,72rem)] border-t border-border-default py-6 text-sm text-content-muted"
  >
    Naira · Rencanakan dengan lebih siap.
  </footer>
</SiteLayout>
