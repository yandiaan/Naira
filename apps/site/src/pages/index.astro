---
import { Button } from '@naira/ui-svelte';
import WelcomeMenu from '../components/WelcomeMenu.svelte';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Naira beranda">Naira</a>
    <WelcomeMenu client:load />
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow">Outdoor planning, made clear</p>
      <h1 id="hero-title">Naira</h1>
      <p class="hero__description">
        Rencanakan perjalanan outdoor dengan lebih siap, dari itinerary sampai daftar gear.
      </p>
      <div class="hero__actions">
        <Button label="Mulai merencanakan" variant="primary" />
        <a class="secondary-link" href="#discovery">Jelajahi inspirasi</a>
      </div>
    </section>

    <section id="discovery" class="discovery" aria-labelledby="discovery-title">
      <p class="eyebrow">Foundation shell</p>
      <h2 id="discovery-title">Semua persiapan dalam satu tempat.</h2>
      <p>
        Public discovery akan menjadi pintu masuk untuk perencanaan trip dan ekosistem pendakian.
      </p>
    </section>
  </main>

  <footer class="site-footer">Naira · Rencanakan dengan lebih siap.</footer>
</SiteLayout>

<style>
  .site-header,
  main,
  .site-footer {
    width: min(100% - 2rem, 72rem);
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--naira-spacing-4) 0;
  }

  .brand {
    color: var(--naira-color-content-default);
    font-size: var(--naira-typography-font-size-lg);
    font-weight: 800;
    text-decoration: none;
  }

  .hero {
    display: grid;
    min-height: 70vh;
    align-content: center;
    gap: var(--naira-spacing-4);
    padding: var(--naira-spacing-8) 0;
  }

  .eyebrow {
    margin: 0;
    color: var(--naira-color-action-primary);
    font-size: var(--naira-typography-font-size-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    font-size: clamp(3rem, 15vw, 7rem);
    line-height: 0.95;
  }

  h2 {
    font-size: clamp(2rem, 6vw, 3.5rem);
  }

  .hero__description,
  .discovery p {
    max-width: 42rem;
    color: var(--naira-color-content-muted);
    font-size: var(--naira-typography-font-size-lg);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--naira-spacing-3);
  }

  .secondary-link {
    color: var(--naira-color-action-primary);
    font-weight: 700;
  }

  .discovery {
    display: grid;
    gap: var(--naira-spacing-4);
    border-top: 1px solid var(--naira-color-border-default);
    padding: var(--naira-spacing-8) 0;
  }

  .site-footer {
    border-top: 1px solid var(--naira-color-border-default);
    padding: var(--naira-spacing-4) 0 var(--naira-spacing-8);
    color: var(--naira-color-content-muted);
    font-size: var(--naira-typography-font-size-sm);
  }
</style>
