---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Naira', description = 'Rencanakan perjalanan outdoor dengan lebih siap.' } =
  Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Lewati ke konten</a>
    <slot />
  </body>
</html>
